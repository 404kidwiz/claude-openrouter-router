#!/usr/bin/env bash
set -euo pipefail

VERSION="0.6.0"
CONFIG_DIR="${CLAUDE_OPENROUTER_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-openrouter-router}"
CONFIG_FILE="$CONFIG_DIR/config"
PROFILES_FILE="$CONFIG_DIR/profiles"
COMMANDS_DIR="${CLAUDE_OPENROUTER_COMMANDS_DIR:-$HOME/.local/bin}"

if [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]; then
  BOLD="$(printf '\033[1m')"
  DIM="$(printf '\033[2m')"
  RESET="$(printf '\033[0m')"
  CYAN="$(printf '\033[36m')"
  GREEN="$(printf '\033[32m')"
  YELLOW="$(printf '\033[33m')"
  BLUE="$(printf '\033[34m')"
  MAGENTA="$(printf '\033[35m')"
else
  BOLD=""
  DIM=""
  RESET=""
  CYAN=""
  GREEN=""
  YELLOW=""
  BLUE=""
  MAGENTA=""
fi

ui_hr() {
  printf '%s\n' "${DIM}+------------------------------------------------------------+${RESET}"
}

ui_title() {
  local title="$1"
  ui_hr
  printf '%s|%s %s%-58s%s %s|%s\n' "$DIM" "$RESET" "$BOLD$CYAN" "$title" "$RESET" "$DIM" "$RESET"
  ui_hr
}

ui_step() {
  printf '\n%s==>%s %s%s%s\n' "$BLUE" "$RESET" "$BOLD" "$1" "$RESET"
}

ui_success() {
  printf '%sOK%s %s\n' "$GREEN" "$RESET" "$1"
}

ui_warn() {
  printf '%sNote:%s %s\n' "$YELLOW" "$RESET" "$1"
}

ui_command() {
  printf '  %s%s%s\n' "$BOLD" "$1" "$RESET"
}

usage() {
  cat <<'EOF'
Usage:
  claude-openrouter [profile|model-id] [--dry-run|--print-env] [claude args...]
  claude-openrouter --setup
  claude-openrouter --set-key <openrouter-api-key>
  claude-openrouter --set-key-stdin
  claude-openrouter --unset-key
  claude-openrouter --set-default-profile <profile>
  claude-openrouter --set-main-model <model>
  claude-openrouter --set-base-url <url>
  claude-openrouter --set-timeout <milliseconds>
  claude-openrouter --show-config
  claude-openrouter install-commands
  claude-openrouter list-commands
  claude-openrouter commands-dir
  claude-openrouter add-model <openrouter-model-id>
  claude-openrouter add-model <name> <openrouter-model-id>
  claude-openrouter --add-profile <openrouter-model-id>
  claude-openrouter --add-profile <name> <openrouter-model-id>
  claude-openrouter --remove-profile <name>
  claude-openrouter --list-profiles

Profiles:
  claude       Strict Claude compatibility. Uses Anthropic first-party models through OpenRouter.
  free         Lowest-cost/free routing via openrouter/free. Best-effort Claude Code compatibility.
  nemotron     nvidia/nemotron-3-super-120b-a12b:free. Best-effort compatibility.
  ring         inclusionai/ring-2.6-1t. Best-effort compatibility.
  owl          openrouter/owl-alpha. Best-effort compatibility.
  pareto-code  openrouter/pareto-code. Best-effort compatibility.
  hunyuan      tencent/hy3-preview. Best-effort compatibility.

Examples:
  claude-openrouter --setup
  claude-openrouter --set-key sk-or-v1-...
  printf '%s' 'sk-or-v1-...' | claude-openrouter --set-key-stdin
  claude-openrouter --set-default-profile free
  claude-openrouter install-commands
  claude-ring -p "Reply with exactly OK"
  claude-openrouter --show-config
  claude-openrouter claude
  claude-openrouter free
  claude-openrouter add-model qwen/qwen3-coder:free
  claude-qwen3-coder -p "Reply with exactly OK"
  claude-openrouter nemotron -p "Reply with exactly OK"
  claude-openrouter openrouter/pareto-code
  claude-openrouter --print-env claude

Environment:
  OPENROUTER_API_KEY                 Required OpenRouter API key.
  CLAUDE_OPENROUTER_BASE_URL          Default: https://openrouter.ai/api
  CLAUDE_OPENROUTER_CONFIG_DIR        Default: ~/.config/claude-openrouter-router
  CLAUDE_OPENROUTER_DEFAULT_PROFILE   Default: claude
  CLAUDE_OPENROUTER_COMMANDS_DIR       Default: ~/.local/bin
  CLAUDE_OPENROUTER_MAIN_MODEL        Main Claude Code model override.
  API_TIMEOUT_MS                      Default: 3000000

Config file:
  ~/.config/claude-openrouter-router/config

Precedence:
  Environment variables override saved config. Saved config overrides built-in defaults.

Notes:
  OpenRouter's Claude Code docs require ANTHROPIC_API_KEY to be explicitly blank.
  The claude profile is the safest profile for Claude Code's tool-use and context features.
EOF
}

die() {
  printf 'Error: %s\n' "$*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

config_value() {
  local key="$1"
  [[ -f "$CONFIG_FILE" ]] || return 1

  awk -F= -v key="$key" '
    /^[[:space:]]*($|#)/ { next }
    $1 == key {
      sub(/^[^=]*=/, "")
      print
      found = 1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "$CONFIG_FILE"
}

config_or_default() {
  local env_value="$1"
  local key="$2"
  local fallback="$3"
  local saved_value

  if [[ -n "$env_value" ]]; then
    printf '%s\n' "$env_value"
    return 0
  fi

  if saved_value="$(config_value "$key")"; then
    printf '%s\n' "$saved_value"
    return 0
  fi

  printf '%s\n' "$fallback"
}

set_config_value() {
  local key="${1:-}"
  local value="${2:-}"

  [[ -n "$key" && -n "$value" ]] || die "Usage: claude-openrouter --set-* <value>"

  ensure_config_dir
  touch "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"

  if awk -F= -v key="$key" '$1 == key { found = 1 } END { exit found ? 0 : 1 }' "$CONFIG_FILE"; then
    local tmp_file
    tmp_file="$(mktemp)"
    awk -F= -v key="$key" -v value="$value" '
      $1 == key { print key "=" value; next }
      { print }
    ' "$CONFIG_FILE" > "$tmp_file"
    mv "$tmp_file" "$CONFIG_FILE"
  else
    printf '%s=%s\n' "$key" "$value" >> "$CONFIG_FILE"
  fi

  chmod 600 "$CONFIG_FILE"
}

unset_config_value() {
  local key="${1:-}"
  [[ -n "$key" ]] || die "Missing config key"
  [[ -f "$CONFIG_FILE" ]] || return 0

  local tmp_file
  tmp_file="$(mktemp)"
  awk -F= -v key="$key" '$1 != key { print }' "$CONFIG_FILE" > "$tmp_file"
  mv "$tmp_file" "$CONFIG_FILE"
  chmod 600 "$CONFIG_FILE"
}

redact_secret() {
  local value="$1"
  if [[ -z "$value" ]]; then
    printf '<not set>\n'
  elif [[ "${#value}" -le 8 ]]; then
    printf '<redacted>\n'
  else
    printf '%s...%s\n' "${value:0:6}" "${value: -4}"
  fi
}

show_config() {
  local saved_key saved_base_url saved_default_profile saved_main_model saved_timeout
  local effective_key effective_base_url effective_default_profile effective_main_model effective_timeout

  saved_key="$(config_value OPENROUTER_API_KEY || true)"
  saved_base_url="$(config_value CLAUDE_OPENROUTER_BASE_URL || true)"
  saved_default_profile="$(config_value CLAUDE_OPENROUTER_DEFAULT_PROFILE || true)"
  saved_main_model="$(config_value CLAUDE_OPENROUTER_MAIN_MODEL || true)"
  saved_timeout="$(config_value API_TIMEOUT_MS || true)"
  effective_key="$(config_or_default "${OPENROUTER_API_KEY:-}" OPENROUTER_API_KEY "")"
  effective_base_url="$(config_or_default "${CLAUDE_OPENROUTER_BASE_URL:-}" CLAUDE_OPENROUTER_BASE_URL "https://openrouter.ai/api")"
  effective_default_profile="$(config_or_default "${CLAUDE_OPENROUTER_DEFAULT_PROFILE:-}" CLAUDE_OPENROUTER_DEFAULT_PROFILE "claude")"
  effective_main_model="$(config_or_default "${CLAUDE_OPENROUTER_MAIN_MODEL:-}" CLAUDE_OPENROUTER_MAIN_MODEL "sonnet")"
  effective_timeout="$(config_or_default "${API_TIMEOUT_MS:-}" API_TIMEOUT_MS "3000000")"

  ui_title "Claude OpenRouter Config"
  printf 'Config file: %s\n' "$CONFIG_FILE"
  printf 'Profiles file: %s\n' "$PROFILES_FILE"
  printf 'Commands dir: %s\n' "$COMMANDS_DIR"
  ui_step "Saved config"
  printf '  OPENROUTER_API_KEY=%s\n' "$(redact_secret "$saved_key")"
  printf '  CLAUDE_OPENROUTER_BASE_URL=%s\n' "${saved_base_url:-<default: https://openrouter.ai/api>}"
  printf '  CLAUDE_OPENROUTER_DEFAULT_PROFILE=%s\n' "${saved_default_profile:-<default: claude>}"
  printf '  CLAUDE_OPENROUTER_MAIN_MODEL=%s\n' "${saved_main_model:-<default: sonnet>}"
  printf '  API_TIMEOUT_MS=%s\n' "${saved_timeout:-<default: 3000000>}"
  ui_step "Effective config"
  printf '  OPENROUTER_API_KEY=%s\n' "$(redact_secret "$effective_key")"
  printf '  CLAUDE_OPENROUTER_BASE_URL=%s\n' "$effective_base_url"
  printf '  CLAUDE_OPENROUTER_DEFAULT_PROFILE=%s\n' "$effective_default_profile"
  printf '  CLAUDE_OPENROUTER_MAIN_MODEL=%s\n' "$effective_main_model"
  printf '  API_TIMEOUT_MS=%s\n' "$effective_timeout"
}

prompt_with_default() {
  local prompt="$1"
  local default="$2"
  local answer

  if [[ -n "$default" ]]; then
    printf '%s [%s]: ' "$prompt" "$default" >&2
  else
    printf '%s: ' "$prompt" >&2
  fi

  IFS= read -r answer || true
  if [[ -n "$answer" ]]; then
    printf '%s\n' "$answer"
  else
    printf '%s\n' "$default"
  fi
}

prompt_secret() {
  local prompt="$1"
  local answer

  printf '%s: ' "$prompt" >&2
  if [[ -t 0 ]]; then
    stty -echo
    IFS= read -r answer || true
    stty echo
    printf '\n' >&2
  else
    IFS= read -r answer || true
  fi
  printf '%s\n' "$answer"
}

yes_answer() {
  case "$1" in
    y|Y|yes|YES|Yes)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

profile_command_name() {
  local profile="$1"
  case "$profile" in
    claude)
      printf '%s\n' "claude-openrouter-claude"
      ;;
    free)
      printf '%s\n' "claude-or-free"
      ;;
    *)
      printf 'claude-%s\n' "$profile"
      ;;
  esac
}

profile_name_from_model() {
  local model="$1"
  local base

  base="${model##*/}"
  base="${base%%:*}"
  base="$(printf '%s\n' "$base" | tr '[:upper:]' '[:lower:]')"
  base="$(printf '%s\n' "$base" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"

  if [[ -z "$base" ]]; then
    base="${model%%/*}"
    base="$(printf '%s\n' "$base" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
  fi

  printf '%s\n' "$base"
}

builtin_profiles() {
  printf '%s\n' claude free nemotron ring owl pareto-code hunyuan
}

all_profile_names() {
  builtin_profiles
  if [[ -s "$PROFILES_FILE" ]]; then
    awk -F= '
      /^[[:space:]]*($|#)/ { next }
      { print $1 }
    ' "$PROFILES_FILE"
  fi
}

write_profile_command() {
  local profile="$1"
  local command_name
  command_name="$(profile_command_name "$profile")"

  mkdir -p "$COMMANDS_DIR"
  cat > "$COMMANDS_DIR/$command_name" <<EOF
#!/usr/bin/env bash
set -euo pipefail

exec claude-openrouter "$profile" "\$@"
EOF
  chmod 0755 "$COMMANDS_DIR/$command_name"
  ui_success "Installed $COMMANDS_DIR/$command_name -> claude-openrouter $profile"
}

print_command_help() {
  local profile="$1"
  local command_name

  command_name="$(profile_command_name "$profile")"

  ui_title "Ready To Run"
  if command -v "$command_name" >/dev/null 2>&1 || [[ -x "$COMMANDS_DIR/$command_name" ]]; then
    ui_command "$command_name"
    ui_command "$command_name -p \"Reply with exactly OK\""
  else
    ui_command "claude-openrouter $profile"
    ui_command "claude-openrouter $profile -p \"Reply with exactly OK\""
    ui_step "Create the shorter $command_name command"
    ui_command "claude-openrouter install-commands"
  fi
  ui_step "Equivalent direct router command"
  ui_command "claude-openrouter $profile"
  ui_step "Useful checks"
  ui_command "claude-openrouter --dry-run $profile"
  ui_command "claude-openrouter list-commands"

  case ":$PATH:" in
    *":$COMMANDS_DIR:"*) ;;
    *)
      ui_warn "If $command_name is not found, add the commands directory to PATH:"
      ui_command "export PATH=\"$COMMANDS_DIR:\$PATH\""
      ;;
  esac
}

install_profile_commands() {
  local profile
  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    write_profile_command "$profile"
  done < <(all_profile_names | awk '!seen[$0]++')

  case ":$PATH:" in
    *":$COMMANDS_DIR:"*) ;;
    *)
      ui_warn "$COMMANDS_DIR is not currently in PATH."
      printf 'Add this to your shell profile:\n' >&2
      printf '  export PATH="%s:$PATH"\n' "$COMMANDS_DIR" >&2
      ;;
  esac

  ui_title "Shortcut Commands Ready"
  ui_command "claude-ring"
  ui_command "claude-owl"
  ui_command "claude-nemotron"
  ui_step "List every available shortcut"
  ui_command "claude-openrouter list-commands"
}

list_profile_commands() {
  local profile command_name
  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    command_name="$(profile_command_name "$profile")"
    printf '%-24s claude-openrouter %s\n' "$command_name" "$profile"
  done < <(all_profile_names | awk '!seen[$0]++')
}

run_setup() {
  local existing_key api_key default_profile main_model base_url timeout add_custom custom_name custom_model install_commands verify_choice

  existing_key="$(config_value OPENROUTER_API_KEY || true)"

  ui_title "Claude OpenRouter Router"
  printf '%s\n' "      .----------------------------."
  printf '%s\n' "     /  OpenRouter -> Claude Code  /|"
  printf '%s\n' "    /----------------------------/ |"
  printf '%s\n' "    |  profiles  shortcuts  API  | /"
  printf '%s\n' "    '----------------------------'"
  ui_step "Setup target"
  printf 'Config file: %s\n' "$CONFIG_FILE"
  ui_step "Get an OpenRouter API key"
  printf 'https://openrouter.ai/settings/keys\n'
  printf '\n%sPress Enter to keep any shown defaults.%s\n\n' "$DIM" "$RESET"

  if [[ -n "$existing_key" ]]; then
    printf 'Existing API key: %s\n' "$(redact_secret "$existing_key")" >&2
    api_key="$(prompt_secret "New OpenRouter API key (leave blank to keep existing)")"
  else
    api_key="$(prompt_secret "OpenRouter API key")"
  fi

  if [[ -n "$api_key" ]]; then
    set_config_value OPENROUTER_API_KEY "$api_key"
    ui_success "Saved API key."
  elif [[ -z "$existing_key" ]]; then
    ui_warn "Skipped API key. You can add it later with:"
    printf "  printf '%%s' 'sk-or-v1-...' | claude-openrouter --set-key-stdin\n" >&2
  else
    ui_success "Kept existing API key."
  fi

  default_profile="$(prompt_with_default "Default profile (claude/free/nemotron/ring/owl/pareto-code/hunyuan/custom)" "$DEFAULT_PROFILE")"
  if [[ -n "$default_profile" ]]; then
    set_config_value CLAUDE_OPENROUTER_DEFAULT_PROFILE "$default_profile"
  fi

  main_model="$(prompt_with_default "Main Claude Code model for strict Claude profile" "$MAIN_MODEL_DEFAULT")"
  if [[ -n "$main_model" ]]; then
    set_config_value CLAUDE_OPENROUTER_MAIN_MODEL "$main_model"
  fi

  base_url="$(prompt_with_default "OpenRouter Anthropic-compatible base URL" "$BASE_URL")"
  if [[ -n "$base_url" ]]; then
    set_config_value CLAUDE_OPENROUTER_BASE_URL "$base_url"
  fi

  timeout="$(prompt_with_default "API timeout in milliseconds" "$TIMEOUT_MS")"
  if [[ "$timeout" =~ ^[0-9]+$ ]]; then
    set_config_value API_TIMEOUT_MS "$timeout"
  else
    printf 'Skipped invalid timeout: %s\n' "$timeout" >&2
  fi

  add_custom="$(prompt_with_default "Add a custom model profile now? (y/N)" "N")"
  while yes_answer "$add_custom"; do
    custom_name="$(prompt_with_default "Custom profile name (leave blank to auto-name from model)" "")"
    custom_model="$(prompt_with_default "OpenRouter model ID (provider/model)" "")"
    if [[ -n "$custom_model" && -z "$custom_name" ]]; then
      custom_name="$(profile_name_from_model "$custom_model")"
    fi
    if [[ -n "$custom_name" && -n "$custom_model" ]]; then
      add_profile "$custom_name" "$custom_model"
    else
      printf 'Skipped empty custom profile.\n' >&2
    fi
    add_custom="$(prompt_with_default "Add another custom profile? (y/N)" "N")"
  done

  install_commands="$(prompt_with_default "Create shortcut commands now? This adds commands like claude-ring and claude-qwen. (Y/n)" "Y")"
  if yes_answer "$install_commands"; then
    install_profile_commands
  fi

  ui_title "Setup Complete"
  show_config

  verify_choice="$(prompt_with_default "Run a dry-run verification now? (Y/n)" "Y")"
  if yes_answer "$verify_choice"; then
    ui_step "Dry run"
    "$0" --dry-run "$(config_value CLAUDE_OPENROUTER_DEFAULT_PROFILE || printf '%s\n' "$DEFAULT_PROFILE")"
  fi

  print_command_help "$(config_value CLAUDE_OPENROUTER_DEFAULT_PROFILE || printf '%s\n' "$DEFAULT_PROFILE")"
}

is_valid_profile_name() {
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]
}

is_builtin_profile() {
  case "$1" in
    claude|compatible|strict|free|auto-free|openrouter-free|nemotron|nvidia-nemotron|ring|ring26|ring-2.6|ring-free|owl|owl-alpha|pareto|pareto-code|code|hunyuan|hy3|tencent)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

ensure_config_dir() {
  mkdir -p "$CONFIG_DIR"
}

lookup_custom_profile() {
  local name="$1"
  [[ -f "$PROFILES_FILE" ]] || return 1

  awk -F= -v key="$name" '
    /^[[:space:]]*($|#)/ { next }
    $1 == key {
      sub(/^[^=]*=/, "")
      print
      found = 1
      exit
    }
    END { exit found ? 0 : 1 }
  ' "$PROFILES_FILE"
}

add_profile() {
  local name="${1:-}"
  local model="${2:-}"

  if [[ -n "$name" && -z "$model" ]]; then
    model="$name"
    name="$(profile_name_from_model "$model")"
  fi

  [[ -n "$name" && -n "$model" ]] || die "Usage: claude-openrouter --add-profile [name] <openrouter-model-id>"
  [[ "$model" == */* ]] || die "Model IDs should look like provider/model, for example moonshotai/kimi-k2:free."
  [[ -n "$name" ]] || die "Could not auto-generate a profile name from '$model'. Pass one explicitly: claude-openrouter --add-profile <name> <openrouter-model-id>"
  is_valid_profile_name "$name" || die "Profile names may only contain letters, numbers, dots, underscores, and dashes."
  is_builtin_profile "$name" && die "'$name' is a built-in profile name. Choose a different custom name."

  ensure_config_dir
  touch "$PROFILES_FILE"

  if awk -F= -v key="$name" '$1 == key { found = 1 } END { exit found ? 0 : 1 }' "$PROFILES_FILE"; then
    local tmp_file
    tmp_file="$(mktemp)"
    awk -F= -v key="$name" -v value="$model" '
      $1 == key { print key "=" value; next }
      { print }
    ' "$PROFILES_FILE" > "$tmp_file"
    mv "$tmp_file" "$PROFILES_FILE"
    printf 'Updated profile %s -> %s\n' "$name" "$model"
  else
    printf '%s=%s\n' "$name" "$model" >> "$PROFILES_FILE"
    printf 'Added profile %s -> %s\n' "$name" "$model"
  fi
}

add_model() {
  local name="${1:-}"
  local model="${2:-}"

  if [[ -n "$name" && -z "$model" ]]; then
    model="$name"
    name="$(profile_name_from_model "$model")"
  fi

  add_profile "$name" "$model"
  write_profile_command "$name"
  print_command_help "$name"
}

remove_profile() {
  local name="${1:-}"

  [[ -n "$name" ]] || die "Usage: claude-openrouter --remove-profile <name>"
  [[ -f "$PROFILES_FILE" ]] || die "No custom profiles file exists at $PROFILES_FILE"

  if ! awk -F= -v key="$name" '$1 == key { found = 1 } END { exit found ? 0 : 1 }' "$PROFILES_FILE"; then
    die "No custom profile named '$name' exists."
  fi

  local tmp_file
  tmp_file="$(mktemp)"
  awk -F= -v key="$name" '$1 != key { print }' "$PROFILES_FILE" > "$tmp_file"
  mv "$tmp_file" "$PROFILES_FILE"
  printf 'Removed profile %s\n' "$name"
}

list_profiles() {
  cat <<'EOF'
Built-in profiles:
  claude       anthropic/claude-* models through OpenRouter
  free         openrouter/free
  nemotron     nvidia/nemotron-3-super-120b-a12b:free
  ring         inclusionai/ring-2.6-1t
  owl          openrouter/owl-alpha
  pareto-code  openrouter/pareto-code
  hunyuan      tencent/hy3-preview
EOF

  printf '\nCustom profiles (%s):\n' "$PROFILES_FILE"
  if [[ ! -s "$PROFILES_FILE" ]]; then
    printf '  none\n'
    return 0
  fi

  awk -F= '
    /^[[:space:]]*($|#)/ { next }
    { printf "  %-12s %s\n", $1, substr($0, index($0, "=") + 1) }
  ' "$PROFILES_FILE"
}

resolve_model() {
  case "$1" in
    claude|compatible|strict)
      printf '%s\n' "claude"
      ;;
    free|auto-free|openrouter-free)
      printf '%s\n' "openrouter/free"
      ;;
    nemotron|nvidia-nemotron)
      printf '%s\n' "nvidia/nemotron-3-super-120b-a12b:free"
      ;;
    ring|ring26|ring-2.6|ring-free)
      printf '%s\n' "inclusionai/ring-2.6-1t"
      ;;
    owl|owl-alpha)
      printf '%s\n' "openrouter/owl-alpha"
      ;;
    pareto|pareto-code|code)
      printf '%s\n' "openrouter/pareto-code"
      ;;
    hunyuan|hy3|tencent)
      printf '%s\n' "tencent/hy3-preview"
      ;;
    *)
      if custom_model="$(lookup_custom_profile "$1")"; then
        printf '%s\n' "$custom_model"
        return 0
      fi
      printf '%s\n' "$1"
      ;;
  esac
}

print_env() {
  for item in "$@"; do
    printf '%q\n' "$item"
  done
}

BASE_URL="$(config_or_default "${CLAUDE_OPENROUTER_BASE_URL:-}" CLAUDE_OPENROUTER_BASE_URL "https://openrouter.ai/api")"
DEFAULT_PROFILE="$(config_or_default "${CLAUDE_OPENROUTER_DEFAULT_PROFILE:-}" CLAUDE_OPENROUTER_DEFAULT_PROFILE "claude")"
MAIN_MODEL_DEFAULT="$(config_or_default "${CLAUDE_OPENROUTER_MAIN_MODEL:-}" CLAUDE_OPENROUTER_MAIN_MODEL "sonnet")"
TIMEOUT_MS="$(config_or_default "${API_TIMEOUT_MS:-}" API_TIMEOUT_MS "3000000")"

dry_run=0
print_only=0

case "${1:-}" in
  -h|--help|help)
    usage
    exit 0
    ;;
  --setup|setup)
    run_setup
    exit 0
    ;;
  --set-key)
    shift
    set_config_value OPENROUTER_API_KEY "${1:-}"
    printf 'Saved OPENROUTER_API_KEY to %s\n' "$CONFIG_FILE"
    exit 0
    ;;
  --set-key-stdin)
    IFS= read -r api_key_from_stdin || true
    [[ -n "$api_key_from_stdin" ]] || die "No API key read from stdin"
    set_config_value OPENROUTER_API_KEY "$api_key_from_stdin"
    printf 'Saved OPENROUTER_API_KEY to %s\n' "$CONFIG_FILE"
    exit 0
    ;;
  --unset-key)
    unset_config_value OPENROUTER_API_KEY
    printf 'Removed OPENROUTER_API_KEY from %s\n' "$CONFIG_FILE"
    exit 0
    ;;
  --set-default-profile)
    shift
    [[ -n "${1:-}" ]] || die "Usage: claude-openrouter --set-default-profile <profile>"
    set_config_value CLAUDE_OPENROUTER_DEFAULT_PROFILE "$1"
    printf 'Saved default profile: %s\n' "$1"
    exit 0
    ;;
  --set-main-model)
    shift
    [[ -n "${1:-}" ]] || die "Usage: claude-openrouter --set-main-model <model>"
    set_config_value CLAUDE_OPENROUTER_MAIN_MODEL "$1"
    printf 'Saved main Claude Code model: %s\n' "$1"
    exit 0
    ;;
  --set-base-url)
    shift
    [[ -n "${1:-}" ]] || die "Usage: claude-openrouter --set-base-url <url>"
    set_config_value CLAUDE_OPENROUTER_BASE_URL "$1"
    printf 'Saved base URL: %s\n' "$1"
    exit 0
    ;;
  --set-timeout)
    shift
    [[ "${1:-}" =~ ^[0-9]+$ ]] || die "Usage: claude-openrouter --set-timeout <milliseconds>"
    set_config_value API_TIMEOUT_MS "$1"
    printf 'Saved API timeout: %s ms\n' "$1"
    exit 0
    ;;
  --show-config|config)
    show_config
    exit 0
    ;;
  --install-profile-commands|--install-commands|install-commands|install-shortcuts)
    install_profile_commands
    exit 0
    ;;
  add-model|--add-model)
    shift
    add_model "${1:-}" "${2:-}"
    exit 0
    ;;
  --list-profile-commands|--list-commands|list-commands|list-shortcuts)
    list_profile_commands
    exit 0
    ;;
  --config-path)
    printf '%s\n' "$CONFIG_FILE"
    exit 0
    ;;
  --commands-dir|commands-dir)
    printf '%s\n' "$COMMANDS_DIR"
    exit 0
    ;;
  --add-profile)
    shift
    add_profile "${1:-}" "${2:-}"
    exit 0
    ;;
  --remove-profile)
    shift
    remove_profile "${1:-}"
    exit 0
    ;;
  --list-profiles|list|profiles)
    list_profiles
    exit 0
    ;;
  -v|--version|version)
    printf 'claude-openrouter %s\n' "$VERSION"
    exit 0
    ;;
  --dry-run)
    dry_run=1
    shift
    ;;
  --print-env)
    print_only=1
    shift
    ;;
esac

profile="$DEFAULT_PROFILE"
if [[ -n "${1:-}" && "$1" != -* ]]; then
  profile="$1"
  shift
fi

need_command claude

api_key="$(config_or_default "${OPENROUTER_API_KEY:-}" OPENROUTER_API_KEY "")"
[[ -n "$api_key" ]] || die "OPENROUTER_API_KEY is not set"

resolved_model="$(resolve_model "$profile")"
model_opus="anthropic/claude-opus-4.7"
model_sonnet="anthropic/claude-sonnet-4.6"
model_haiku="anthropic/claude-haiku-4.5"
subagent_model="$model_haiku"
main_model="$MAIN_MODEL_DEFAULT"

if [[ "$resolved_model" != "claude" ]]; then
  model_opus="$resolved_model"
  model_sonnet="$resolved_model"
  model_haiku="$resolved_model"
  subagent_model="$resolved_model"
  main_model="$resolved_model"
fi

env_args=(
  -u ANTHROPIC_BASE_URL
  -u ANTHROPIC_AUTH_TOKEN
  -u ANTHROPIC_API_KEY
  -u ANTHROPIC_DEFAULT_OPUS_MODEL
  -u ANTHROPIC_DEFAULT_SONNET_MODEL
  -u ANTHROPIC_DEFAULT_HAIKU_MODEL
  -u ANTHROPIC_SMALL_FAST_MODEL
  -u CLAUDE_CODE_SUBAGENT_MODEL
  -u CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK
  "ANTHROPIC_BASE_URL=$BASE_URL"
  "ANTHROPIC_AUTH_TOKEN=$api_key"
  "ANTHROPIC_API_KEY="
  "ANTHROPIC_MODEL=$main_model"
  "ANTHROPIC_DEFAULT_OPUS_MODEL=$model_opus"
  "ANTHROPIC_DEFAULT_SONNET_MODEL=$model_sonnet"
  "ANTHROPIC_DEFAULT_HAIKU_MODEL=$model_haiku"
  "ANTHROPIC_SMALL_FAST_MODEL=$model_haiku"
  "CLAUDE_CODE_SUBAGENT_MODEL=$subagent_model"
  "CLAUDE_CODE_SKIP_FAST_MODE_ORG_CHECK=1"
  "API_TIMEOUT_MS=$TIMEOUT_MS"
)

if [[ "$print_only" == "1" || "$dry_run" == "1" ]]; then
  printf 'Profile: %s\n' "$profile"
  printf 'Resolved model: %s\n' "$resolved_model"
  printf 'Command: claude %s\n' "$*"
  printf '\nEnvironment:\n'
  for env_item in "${env_args[@]}"; do
    [[ "$env_item" == OPENROUTER_API_KEY=* || "$env_item" == ANTHROPIC_AUTH_TOKEN=* ]] && continue
    [[ "$env_item" == -* ]] && continue
    [[ "$env_item" == *"="* ]] || continue
    printf '  %s\n' "$env_item"
  done
  printf '  ANTHROPIC_AUTH_TOKEN=<redacted>\n'
  [[ "$dry_run" == "1" ]] && exit 0
  [[ "$print_only" == "1" ]] && exit 0
fi

exec env "${env_args[@]}" claude "$@"
